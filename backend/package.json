{
  "name": "meditrack-backend",
  "version": "1.0.0",
  "description": "MediTrack - Smart Medicine Management & Medication Adherence System Backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "ts-node src/scripts/migrate.ts",
    "seed": "ts-node src/scripts/seed.ts --authorized",
    "clean-slate": "ts-node src/scripts/clean-slate.ts --authorized",
    "test:scheduler": "ts-node src/scripts/test-scheduler.ts --authorized",
    "test:cors": "ts-node src/scripts/test-cors-security.ts --authorized",
    "test:outbox": "ts-node src/scripts/test-notification-outbox.ts --authorized",
    "test:e2e": "ts-node src/scripts/test-e2e.ts --authorized",
    "test:uat": "ts-node src/scripts/test-uat.ts --authorized",
    "test:browser": "ts-node src/scripts/test-browser-e2e.ts --authorized",
    "test:concurrency": "ts-node src/scripts/test-concurrency.ts --authorized",
    "test:api-concurrency": "ts-node src/scripts/test-api-concurrency.ts --authorized",
    "test": "ts-node src/scripts/test-scheduler.ts --authorized && ts-node src/scripts/test-e2e.ts --authorized && ts-node src/scripts/test-uat.ts --authorized && ts-node src/scripts/test-concurrency.ts --authorized && ts-node src/scripts/test-api-concurrency.ts --authorized"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.48.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.16",
    "pdfkit": "^0.15.2",
    "pg": "^8.13.1",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.1",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.13.8",
    "@types/pg": "^8.11.10",
    "@types/web-push": "^3.6.4",
    "playwright": "^1.65.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
