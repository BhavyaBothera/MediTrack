# ==============================================================================
# MediTrack Environment Configuration Template
# Copy this file to .env and populate with your credentials.
# NEVER commit your actual .env file with real secrets to version control!
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
TIMEZONE=Asia/Kolkata
FRONTEND_URL=http://localhost:5000
# Comma-separated list of additional allowed origins for CORS in production:
# ALLOWED_ORIGINS=https://meditrack.yourdomain.com,https://app.meditrack.org
TRUST_PROXY=false

# Supabase Credentials (Required)
# Retrieve these from your Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
SUPABASE_SECRET_KEY=your_supabase_secret_key

# Optional: Email / SMTP Gateway (Active in simulated test-mode if omitted)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=your_smtp_password
SMTP_FROM="MediTrack Alerts <alerts@meditrack.local>"

# Optional: WhatsApp Cloud API (Meta Developer Console)
WHATSAPP_TOKEN=your_meta_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id

# Optional: SMS Gateway (Twilio / Gupshup / Fast2SMS)
SMS_API_KEY=your_sms_gateway_api_key
SMS_SENDER_ID=MEDTRK

# Optional: Web Push Notifications (VAPID Keys)
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@meditrack.local

